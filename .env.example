# Copy to .env and adjust as needed. All values are optional.

# --- Server ---
PORT=4000

# Where projects, media, and renders are stored on disk.
CLIPSTITCH_DATA_DIR=./data

# External binaries (must be installed and on PATH, or give absolute paths).
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
GALLERY_DL_BIN=gallery-dl

# Optional TTF for burned-in captions. If unset, common system fonts are tried,
# then fontconfig's "Sans". Caption burn-in requires an ffmpeg build with the
# drawtext filter (libfreetype); if absent, renders still succeed and captions
# are skipped with a warning.
# CLIPSTITCH_FONT=/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf

# Ingest / render limits.
MAX_PINTEREST_ITEMS=100
MAX_RENDERS_KEPT=10

# Comma-separated allowed CORS origins (empty = allow all, fine for local dev).
# CORS_ORIGINS=http://localhost:5173

# --- Client (build/dev time) ---
# Backend origin the frontend talks to. Leave empty to use same-origin +
# the Vite dev proxy (recommended). Set only for a split deployment.
# VITE_API_BASE=
# VITE_PROXY_TARGET=http://localhost:4000
